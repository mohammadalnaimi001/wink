# ============================================================
#  Wink Cafe — environment settings
#  Copy this file to ".env" and fill in your own values.
# ============================================================

# Port the site runs on
PORT=3000

# Timezone (leave as-is for Jordan)
TZ=Asia/Amman

# Admin dashboard password  ← CHANGE THIS BEFORE GOING LIVE
ADMIN_PASSWORD=wink2026

# Random string that signs the admin login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true only when the site is served over HTTPS
SECURE_COOKIE=false

# ---------- Email notifications (optional) ----------
# Leave these blank and the site still works: bookings save to the
# database and the WhatsApp button still works. Fill them in to also
# receive an email for every booking.
#
# Gmail example: create an "App Password" in your Google account first.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wink Cafe" <bookings@winkcafe.jo>
ADMIN_EMAIL=
